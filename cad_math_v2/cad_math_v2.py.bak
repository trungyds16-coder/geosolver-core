        self.mat_result_box = scrolledtext.ScrolledText(bot_f, font=("Consolas", self.current_font_size), bg="#ffffff", fg="#0f172a", relief="solid", bd=1)
        self.mat_result_box.pack(fill=tk.BOTH, expand=True)

    def load_matrix_sample(self, txt_a: str, txt_b: str, op: str):
        self.mat_a_entry.delete("1.0", tk.END); self.mat_a_entry.insert(tk.END, txt_a)
        self.mat_b_entry.delete("1.0", tk.END); self.mat_b_entry.insert(tk.END, txt_b)
        self.solve_matrix_action(op)

    def parse_matrix_from_widget(self, widget) -> sp.Matrix:
        raw = widget.get("1.0", tk.END).strip()
        if not raw:
            raise ValueError("Vui lòng nhập các phần tử của ma trận!")
        rows = []
        for line in raw.splitlines():
            line = line.strip().strip('[]')
            if not line:
                continue
            parts = [sp.sympify(p.strip()) for p in line.replace(',', ' ').split() if p.strip()]
            if parts:
                rows.append(parts)
        if not rows:
            raise ValueError("Không nhận diện được hàng nào trong ma trận!")
        n_cols = len(rows[0])
        for idx, r in enumerate(rows, 1):
            if len(r) != n_cols:
                raise ValueError(f"Hàng {idx} có {len(r)} phần tử, không khớp với hàng đầu ({n_cols} phần tử)!")
        return sp.Matrix(rows)

    def format_matrix_text(self, M: sp.Matrix) -> str:
        rows = M.tolist()
        str_rows = ["  ".join([str(cell).center(7) for cell in row]) for row in rows]
        return "\n".join(str_rows)

    def solve_matrix_action(self, op: str):
        try:
            self.mat_result_box.delete("1.0", tk.END)
            A = self.parse_matrix_from_widget(self.mat_a_entry)
            B = None
            if op in ["A*B", "A+B", "A-B", "B*A", "solveAXB"]:
                B = self.parse_matrix_from_widget(self.mat_b_entry)

            out = []
            out.append("="*85)
            out.append(f"HỆ THỐNG ĐẠI SỐ TUYẾN TÍNH & MA TRẬN CAS: PHÉP TOÁN [{op}]")
            out.append("="*85)
            out.append(f"\nMA TRẬN A ({A.rows} x {A.cols}):\n{self.format_matrix_text(A)}")
            if B is not None:
                out.append(f"\nMA TRẬN B ({B.rows} x {B.cols}):\n{self.format_matrix_text(B)}")

            if op == "A*B":
                if A.cols != B.rows:
                    raise ValueError(f"Không thể nhân: Số cột của A ({A.cols}) phải bằng số hàng của B ({B.rows})!")
                C = A * B
                out.append(f"\n[QUY TẮC NHÂN MA TRẬN: HÀNG NHÂN CỘT]:")
                out.append(f"  • Kích thước kết quả C = A × B là: ({A.rows} x {B.cols})")
                out.append("  • Công thức từng phần tử: c_{ij} = ∑_{k=1}^n a_{ik} · b_{kj}")
                out.append("  • Chi tiết tính toán một số phần tử tiêu biểu:")
                for i in range(min(3, A.rows)):
                    for j in range(min(3, B.cols)):
                        terms = [f"{A[i, k]}·({B[k, j]})" for k in range(A.cols)]
                        out.append(f"    c_{i+1}{j+1} = {' + '.join(terms)} = {C[i, j]}")

                out.append(f"\n[KẾT QUẢ MA TRẬN TÍCH C = A × B]:\n{self.format_matrix_text(C)}")
                repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in C.tolist()])
                self.mat_result_canvas.render_latex(f"C = A \\times B = \\left[ {repr_rows} \\right]")

            elif op == "A+B":
                if A.rows != B.rows or A.cols != B.cols:
                    raise ValueError(f"Không thể cộng: A ({A.rows}x{A.cols}) và B ({B.rows}x{B.cols}) phải cùng kích thước!")
                C = A + B
                out.append(f"\n[QUY TẮC CỘNG TỪNG PHẦN TỬ]: c_{{ij}} = a_{{ij}} + b_{{ij}}")
                out.append(f"\n[KẾT QUẢ MA TRẬN TỔNG C = A + B]:\n{self.format_matrix_text(C)}")
                repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in C.tolist()])
                self.mat_result_canvas.render_latex(f"C = A + B = \\left[ {repr_rows} \\right]")

            elif op == "A-B":
                if A.rows != B.rows or A.cols != B.cols:
                    raise ValueError(f"Không thể trừ: A ({A.rows}x{A.cols}) và B ({B.rows}x{B.cols}) phải cùng kích thước!")
                C = A - B
                out.append(f"\n[QUY TẮC TRỪ TỪNG PHẦN TỬ]: c_{{ij}} = a_{{ij}} - b_{{ij}}")
                out.append(f"\n[KẾT QUẢ MA TRẬN HIỆU C = A - B]:\n{self.format_matrix_text(C)}")
                repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in C.tolist()])
                self.mat_result_canvas.render_latex(f"C = A - B = \\left[ {repr_rows} \\right]")

            elif op == "B*A":
                if B.cols != A.rows:
                    raise ValueError(f"Không thể nhân: Số cột của B ({B.cols}) phải bằng số hàng của A ({A.rows})!")
                C = B * A
                out.append(f"\n[KẾT QUẢ MA TRẬN TÍCH C = B × A]:\n{self.format_matrix_text(C)}")
                repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in C.tolist()])
                self.mat_result_canvas.render_latex(f"C = B \\times A = \\left[ {repr_rows} \\right]")

            elif op == "invA":
                if A.rows != A.cols:
                    raise ValueError("Chỉ ma trận vuông (n x n) mới có thể tìm ma trận nghịch đảo!")
                detA = A.det()
                out.append(f"\n[BƯỚC 1: TÍNH ĐỊNH THỨC det(A)]")
                out.append(f"  det(A) = {detA}")
                if detA == 0:
                    out.append("  ==> det(A) = 0 nên ma trận A SUY BIẾN (không khả nghịch, không tồn tại A⁻¹).")
                    self.mat_result_canvas.render_latex(r"\det(A) = 0 \implies \text{Không khả nghịch}")
                else:
                    out.append("\n[BƯỚC 2: TÌM MA TRẬN PHỤ ĐẠI SỐ (ADJUGATE MATRIX)]")
                    adjA = A.adjugate()
                    out.append(f"  adj(A) =\n{self.format_matrix_text(adjA)}")
                    invA = A.inv()
                    out.append(f"\n[BƯỚC 3: CÔNG THỨC A⁻¹ = (1/det(A)) · adj(A)]:\n{self.format_matrix_text(invA)}")
                    repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in invA.tolist()])
                    self.mat_result_canvas.render_latex(f"A^{{-1}} = \\left[ {repr_rows} \\right]")

            elif op == "detA":
                if A.rows != A.cols:
                    raise ValueError("Chỉ ma trận vuông mới có định thức det!")
                detA = A.det()
                out.append(f"\n[TÍNH ĐỊNH THỨC MA TRẬN VUÔNG A ({A.rows} x {A.cols})]:")
                if A.rows == 2:
                    out.append(f"  Áp dụng quy tắc đường chéo: a·d - b·c")
                    out.append(f"  det(A) = ({A[0,0]})·({A[1,1]}) - ({A[0,1]})·({A[1,0]}) = {detA}")
                else:
                    out.append(f"  Áp dụng khai triển Laplace hoặc đưa về ma trận tam giác:")
                    out.append(f"  det(A) = {detA}")
                self.mat_result_canvas.render_latex(f"\\det(A) = {detA}")

            elif op == "rankA":
                r = A.rank()
                rref_mat, pivots = A.rref()
                out.append(f"\n[BƯỚC 1: ĐƯA MA TRẬN VỀ DẠNG BẬC THANG RÚT GỌN (RREF)]:\n{self.format_matrix_text(rref_mat)}")
                out.append(f"\n[BƯỚC 2: ĐẾM SỐ CỘT CƠ SỞ (PIVOTS)]: {len(pivots)} cột cơ sở")
                out.append(f"==> HẠNG MA TRẬN rank(A) = {r}")
                self.mat_result_canvas.render_latex(f"\\text{{rank}}(A) = {r}")

            elif op == "transA":
                At = A.T
                out.append(f"\n[QUY TẮC CHUYỂN VỊ: BIẾN DÒNG THÀNH CỘT]:\n{self.format_matrix_text(At)}")
                repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in At.tolist()])
                self.mat_result_canvas.render_latex(f"A^T = \\left[ {repr_rows} \\right]")

            elif op == "solveAXB":
                if A.rows != B.rows:
                    raise ValueError(f"Số hàng của A ({A.rows}) phải bằng số hàng của vector B ({B.rows})!")
                out.append("\n[BƯỚC 1: THIẾT LẬP MA TRẬN MỞ RỘNG (A | B)]")
                aug = A.row_join(B)
                out.append(self.format_matrix_text(aug))

                try:
                    X = A.LUsolve(B)
                    out.append(f"\n[BƯỚC 2: GIẢI BẰNG PHƯƠNG PHÁP KHỬ GAUSS-JORDAN HOẶC A⁻¹ · B]")
                    out.append(f"==> NGHIỆM MA TRẬN X:\n{self.format_matrix_text(X)}")
                    repr_rows = "; ".join([", ".join([str(c) for c in r]) for r in X.tolist()])
                    self.mat_result_canvas.render_latex(f"X = \\left[ {repr_rows} \\right]")
                except Exception as e_solve:
                    out.append(f"\n[KẾT LUẬN]: Hệ phương trình vô nghiệm hoặc vô số nghiệm: {e_solve}")
                    self.mat_result_canvas.render_latex(r"\text{Hệ vô nghiệm hoặc vô số nghiệm}")

            elif op == "eigenA":
                if A.rows != A.cols:
                    raise ValueError("Chỉ ma trận vuông mới có trị riêng và vector riêng!")
                lam = sp.Symbol('lambda')
                char_poly = A.charpoly(lam)
                out.append(f"\n[BƯỚC 1: PHƯƠNG TRÌNH ĐẶC TRƯNG det(A - λI) = 0]:")
                out.append(f"  P(λ) = {clean_display_expr(char_poly.as_expr())} = 0")

                e_vects = A.eigenvects()
                out.append(f"\n[BƯỚC 2: CÁC TRỊ RIÊNG VÀ KHÔNG GIAN VECTOR RIÊNG]:")
                eigen_strs = []
                for val, mult, basis in e_vects:
                    v_clean = clean_display_expr(val)
                    eigen_strs.append(f"λ = {v_clean}")
                    out.append(f"  • Trị riêng λ = {v_clean} (Bội đại số = {mult}):")
                    for b in basis:
                        out.append(f"      Vector riêng v = {b.tolist()}")

                self.mat_result_canvas.render_latex(" \\;; \\quad ".join(eigen_strs[:3]))

            self.mat_result_box.insert(tk.END, "\n".join(out))

        except Exception as e:
            self.mat_result_box.insert(tk.END, f"[LỖI MA TRẬN]: {e}")

    # --------------------------------------------------------------------------
    # TAB 5: TỔ HỢP - XÁC SUẤT & THỐNG KÊ TOÀN DIỆN
    # --------------------------------------------------------------------------
    def create_statistics_tab(self):
        tab = ttk.Frame(self.notebook, padding=8)
        self.notebook.add(tab, text="5. Tổ Hợp - Xác Suất & Thống Kê")

        top_f = tk.Frame(tab, bg="#ffffff")
        top_f.pack(fill=tk.X, pady=(0, 4))

        tk.Label(top_f, text="BỘ CÔNG CỤ TỔ HỢP - XÁC SUẤT & THỐNG KÊ MÔ TẢ TOÀN DIỆN:",
                 font=("Segoe UI", 9, "bold"), fg="#1e293b", bg="#ffffff").pack(anchor="w")

        mode_f = tk.Frame(top_f, bg="#ffffff")
        mode_f.pack(fill=tk.X, pady=(2, 4))

        tk.Label(mode_f, text="Chế độ:", font=("Segoe UI", 9, "bold"), bg="#ffffff").pack(side=tk.LEFT)
        self.stat_mode = ttk.Combobox(
            mode_f, width=35, state="readonly",
            values=[
                "1. Đại số Tổ hợp & Nhị thức Newton",
                "2. Xác suất & Phân phối Nhị thức B(n, p)",
                "3. Thống kê mô tả toàn diện (Mean, SD, IQR, Boxplot)"
            ]
        )
        self.stat_mode.pack(side=tk.LEFT, padx=(4, 12))
        self.stat_mode.set("3. Thống kê mô tả toàn diện (Mean, SD, IQR, Boxplot)")
        self.stat_mode.bind("<<ComboboxSelected>>", lambda e: self.update_stat_input_fields())

        self.stat_input_frame = tk.Frame(top_f, bg="#ffffff")
        self.stat_input_frame.pack(fill=tk.X, pady=(2, 4))

        self.stat_lbl1 = tk.Label(self.stat_input_frame, text="Dữ liệu mẫu số liệu (cách nhau bởi dấu phẩy hoặc khoảng trắng):",
                                  font=("Segoe UI", 9), bg="#ffffff")
        self.stat_lbl1.pack(anchor="w")

        self.stat_entry1 = ttk.Entry(self.stat_input_frame, font=("Consolas", 11))
        self.stat_entry1.pack(fill=tk.X, pady=(2, 4))
        self.stat_entry1.insert(0, "12, 15, 14, 18, 19, 15, 16, 20, 22, 15, 17, 35")

        act_f = tk.Frame(top_f, bg="#ffffff")
        act_f.pack(fill=tk.X, pady=(2, 4))

        self.btn_stat = tk.Button(
            act_f, text="Phân tích thống kê",
            font=("Segoe UI", 8, "bold"), bg="#0969da", fg="#ffffff",
            relief="flat", padx=10, pady=3, cursor="hand2",
            command=self.solve_statistics_action
        )
        self.btn_stat.pack(side=tk.LEFT, padx=(0, 10))

        tk.Button(act_f, text="Mẫu Thống Kê Có Điểm Ngoại Lai", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_stat_sample("12, 15, 14, 18, 19, 15, 16, 20, 22, 15, 17, 35")).pack(side=tk.LEFT, padx=3)
        tk.Button(act_f, text="Mẫu Nhị Thức Newton (2x - 3)^6", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_binomial_sample("2*x - 3", "6")).pack(side=tk.LEFT, padx=3)
        tk.Button(act_f, text="Mẫu Phân Phối B(20, 0.4)", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_prob_sample("20", "0.4")).pack(side=tk.LEFT, padx=3)

        bot_f = tk.Frame(tab, bg="#ffffff")
        bot_f.pack(fill=tk.BOTH, expand=True)

        left_f = tk.Frame(bot_f, bg="#ffffff")
        left_f.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(0, 4))

        tk.Label(left_f, text="BẢNG CHỈ SỐ THỐNG KÊ MÔ TẢ (DESCRIPTIVE STATISTICS SUMMARY):",
                 font=("Segoe UI", 9, "bold"), fg="#1e293b", bg="#ffffff").pack(anchor="w")
        self.stat_result_box = scrolledtext.ScrolledText(left_f, font=("Consolas", self.current_font_size), bg="#ffffff", fg="#0f172a", relief="solid", bd=1)
        self.stat_result_box.pack(fill=tk.BOTH, expand=True)

        right_f = tk.LabelFrame(bot_f, text="BIỂU ĐỒ PHÂN PHỐI TẦN SỐ (HISTOGRAM) & BIỂU ĐỒ HỘP (BOXPLOT)",
                                font=("Segoe UI", 8, "bold"), fg="#0969da", bg="#ffffff")
        right_f.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True, padx=(4, 0))

        self.stat_fig = Figure(figsize=(4.5, 4), dpi=100, facecolor='#ffffff')
        self.stat_ax1 = self.stat_fig.add_subplot(211)
        self.stat_ax2 = self.stat_fig.add_subplot(212)
        self.stat_canvas = FigureCanvasTkAgg(self.stat_fig, master=right_f)
        self.stat_canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)

    def update_stat_input_fields(self):
        mode = self.stat_mode.get()
        if "1. Đại số" in mode:
            self.stat_lbl1.config(text="Nhập biểu thức nhị thức dạng (a*x + b)^n hoặc số n, k:")
            self.stat_entry1.delete(0, tk.END)
            self.stat_entry1.insert(0, "(2*x - 3)^6")
        elif "2. Xác suất" in mode:
            self.stat_lbl1.config(text="Nhập số lần thử n và xác suất thành công p dạng 'n, p' (VD: 20, 0.4):")
            self.stat_entry1.delete(0, tk.END)
            self.stat_entry1.insert(0, "20, 0.4")
        else:
            self.stat_lbl1.config(text="Dữ liệu mẫu số liệu (cách nhau bởi dấu phẩy hoặc khoảng trắng):")
            self.stat_entry1.delete(0, tk.END)
            self.stat_entry1.insert(0, "12, 15, 14, 18, 19, 15, 16, 20, 22, 15, 17, 35")

    def load_stat_sample(self, txt: str):
        self.stat_mode.set("3. Thống kê mô tả toàn diện (Mean, SD, IQR, Boxplot)")
        self.update_stat_input_fields()
        self.stat_entry1.delete(0, tk.END); self.stat_entry1.insert(0, txt)
        self.solve_statistics_action()

    def load_binomial_sample(self, expr: str, n_pow: str):
        self.stat_mode.set("1. Đại số Tổ hợp & Nhị thức Newton")
        self.update_stat_input_fields()
        self.stat_entry1.delete(0, tk.END); self.stat_entry1.insert(0, f"({expr})^{n_pow}")
        self.solve_statistics_action()

    def load_prob_sample(self, n_val: str, p_val: str):
        self.stat_mode.set("2. Xác suất & Phân phối Nhị thức B(n, p)")
        self.update_stat_input_fields()
        self.stat_entry1.delete(0, tk.END); self.stat_entry1.insert(0, f"{n_val}, {p_val}")
        self.solve_statistics_action()

    def solve_statistics_action(self):
        try:
            self.stat_result_box.delete("1.0", tk.END)
            mode = self.stat_mode.get()
            raw_input = self.stat_entry1.get().strip()

            out = []
            out.append("="*85)
            out.append(f"HỆ THỐNG PHÂN TÍCH TỔ HỢP - XÁC SUẤT & THỐNG KÊ CHUYÊN SÂU")
            out.append("="*85)

            if "1. Đại số" in mode:
                if '^' in raw_input or '**' in raw_input:
                    poly_expr = smart_parse(raw_input)
                    expanded = sp.expand(poly_expr)
                    out.append(f"\n[KHAI TRIỂN NHỊ THỨC NEWTON]: ({raw_input})")
                    out.append(f"  Biểu thức khai triển đầy đủ:")
                    out.append(f"    P(x) = {clean_display_expr(expanded)}")
                    out.append(f"\n[BẢNG HỆ SỐ CỦA CÁC SỐ HẠNG]:")
                    poly_x = sp.Poly(expanded, x)
                    coeffs = poly_x.all_coeffs()
                    degrees = range(poly_x.degree(), -1, -1)
                    for d, c in zip(degrees, coeffs):
                        out.append(f"  • Hệ số của x^{d}: {clean_display_expr(c)}")
                else:
                    parts = [int(p.strip()) for p in raw_input.replace(',', ' ').split() if p.strip()]
                    n_val = parts[0]
                    k_val = parts[1] if len(parts) > 1 else 1
                    pn = math.factorial(n_val)
                    ank = math.perm(n_val, k_val)
                    cnk = math.comb(n_val, k_val)
                    out.append(f"\n[ĐẠI SỐ TỔ HỢP]: n = {n_val}, k = {k_val}")
                    out.append(f"  • Hoán vị P_{n_val} = {n_val}! = {pn}")
                    out.append(f"  • Chỉnh hợp A_{n_val}^{k_val} = {n_val}! / ({n_val} - {k_val})! = {ank}")
                    out.append(f"  • Tổ hợp C_{n_val}^{k_val} = {n_val}! / [{k_val}!({n_val} - {k_val})!] = {cnk}")

            elif "2. Xác suất" in mode:
                parts = [float(p.strip()) for p in raw_input.replace(',', ' ').split() if p.strip()]
                n_trials = int(parts[0])
                p_prob = parts[1]
                q_prob = 1.0 - p_prob
                ex = n_trials * p_prob
                vx = n_trials * p_prob * q_prob
                sdx = math.sqrt(vx)

                out.append(f"\n[PHÂN PHỐI NHỊ THỨC]: X ~ B(n = {n_trials}, p = {p_prob})")
                out.append(f"  • Kỳ vọng toán học E(X) = n·p = {ex:.4f}")
                out.append(f"  • Phương sai V(X) = n·p·(1 - p) = {vx:.4f}")
                out.append(f"  • Độ lệch chuẩn σ(X) = √V(X) = {sdx:.4f}")
                out.append(f"\n[BẢNG PHÂN PHỐI XÁC SUẤT P(X = k)]:")

                ks = np.arange(0, n_trials + 1)
                probs = [math.comb(n_trials, int(k_i)) * (p_prob**k_i) * (q_prob**(n_trials - k_i)) for k_i in ks]
                for k_i, pr in zip(ks[:15], probs[:15]):
                    out.append(f"  • P(X = {k_i:2d}) = {pr:.5f}")
                if len(ks) > 15:
                    out.append(f"  ... (Hiển thị 15 giá trị đầu tiên)")

                self.stat_ax1.clear()
                self.stat_ax2.clear()
                self.stat_ax1.bar(ks, probs, color='#0969da', alpha=0.85, width=0.6)
                self.stat_ax1.set_title(f"Phân Phối Xác Suất Nhị Thức B({n_trials}, {p_prob})", fontsize=8, fontweight='bold')
                self.stat_ax1.grid(True, ls=':', color='#cbd5e1')
                self.stat_ax2.plot(ks, np.cumsum(probs), color='#16a34a', lw=2, marker='.')
                self.stat_ax2.set_title("Hàm Phân Phối Tích Lũy F(x) = P(X <= k)", fontsize=8, fontweight='bold')
                self.stat_ax2.grid(True, ls=':', color='#cbd5e1')
                self.stat_fig.tight_layout()
                self.stat_canvas.draw()

            else:
                numbers = [float(item.strip()) for item in re.split(r'[,;\s]+', raw_input) if item.strip()]
                if not numbers:
                    messagebox.showwarning("Cảnh báo", "Vui lòng nhập danh sách số liệu!")
                    return

                data = np.array(numbers)
                N = len(data)
                mean_val = np.mean(data)
                median_val = np.median(data)
                from collections import Counter
                counts = Counter(numbers)
                mode_val = counts.most_common(1)[0][0]

                q1 = np.percentile(data, 25)
                q2 = np.percentile(data, 50)
                q3 = np.percentile(data, 75)
                iqr = q3 - q1
                min_val = np.min(data)
                max_val = np.max(data)
                range_val = max_val - min_val

                var_sample = np.var(data, ddof=1) if N > 1 else 0.0
                std_sample = np.std(data, ddof=1) if N > 1 else 0.0
                cv = (std_sample / mean_val) * 100 if mean_val != 0 else 0.0

                lower_bound = q1 - 1.5 * iqr
                upper_bound = q3 + 1.5 * iqr
                outliers = data[(data < lower_bound) | (data > upper_bound)]

                out.append("\n" + "-"*85)
                out.append("BẢNG TỔNG HỢP CÁC ĐẶC TRƯNG ĐO LƯỜNG XU HƯỚNG TRUNG TÂM & ĐỘ PHÂN TÁN:")
                out.append("-"*85)
                out.append(f"  • Cỡ mẫu quan sát (Sample Size N)        : {N}")
                out.append(f"  • Giá trị trung bình (Mean x̄)             : {mean_val:.4f}")
                out.append(f"  • Trung vị (Median Me)                    : {median_val:.4f}")
                out.append(f"  • Mốt (Mode Mo)                           : {mode_val:.4f}")
                out.append(f"  • Phương sai mẫu hiệu chỉnh (Variance s²) : {var_sample:.4f}")
                out.append(f"  • Độ lệch chuẩn mẫu (Std Dev s)           : {std_sample:.4f}")
                out.append(f"  • Hệ số biến thiên (CV)                   : {cv:.2f} %")
                out.append(f"  • Khoảng biến thiên (Range R)             : {range_val:.4f}  (Min: {min_val:.2f}, Max: {max_val:.2f})")
                out.append(f"\nBẢNG PHÂN VỊ VÀ ĐÁNH GIÁ NGOẠI LAI (QUARTILES & OUTLIERS):")
                out.append(f"  • Tứ phân vị thứ nhất (Q1 - 25%)          : {q1:.4f}")
                out.append(f"  • Tứ phân vị thứ hai  (Q2/Median - 50%)   : {q2:.4f}")
                out.append(f"  • Tứ phân vị thứ ba   (Q3 - 75%)          : {q3:.4f}")
                out.append(f"  • Khoảng tứ phân vị (IQR = Q3 - Q1)       : {iqr:.4f}")
                out.append(f"  • Ranh giới hợp lệ: [{lower_bound:.2f} ; {upper_bound:.2f}]")
                if len(outliers) > 0:
                    out.append(f"  ==> PHÁT HIỆN GIÁ TRỊ NGOẠI LAI (Outliers): {list(outliers)}")
                else:
                    out.append(f"  ==> Không phát hiện giá trị ngoại lai bất thường trong mẫu số liệu.")

                self.stat_ax1.clear()
                self.stat_ax2.clear()

                self.stat_ax1.hist(data, bins='auto', color='#0969da', edgecolor='#1e293b', alpha=0.75)
                self.stat_ax1.axvline(mean_val, color='#ef4444', lw=1.8, ls='--', label=f'Mean={mean_val:.2f}')
                self.stat_ax1.axvline(median_val, color='#16a34a', lw=1.8, ls=':', label=f'Median={median_val:.2f}')
                self.stat_ax1.set_title(f"Biểu Đồ Tần Số (Histogram, N={N})", fontsize=8, fontweight='bold')
                self.stat_ax1.legend(loc='upper right', fontsize=8)
                self.stat_ax1.grid(True, ls=':', color='#cbd5e1')

                self.stat_ax2.boxplot(data, vert=False, patch_artist=True,
                                      boxprops=dict(facecolor='#dbeafe', color='#1d4ed8'),
                                      medianprops=dict(color='#ef4444', lw=2),
                                      flierprops=dict(marker='o', markerfacecolor='#dc2626', markersize=6))
                self.stat_ax2.set_title("Biểu Đồ Hộp Râu (Boxplot & Outliers)", fontsize=8, fontweight='bold')
                self.stat_ax2.grid(True, ls=':', color='#cbd5e1')

                self.stat_fig.tight_layout()
                self.stat_canvas.draw()

            self.stat_result_box.insert(tk.END, "\n".join(out))

        except Exception as e:
            self.stat_result_box.insert(tk.END, f"[LỖI THỐNG KÊ]: {e}")

    # --------------------------------------------------------------------------
    # TAB 6: KHẢO SÁT HÀM SỐ & ĐỒ THỊ 2D TRÊN MẶT PHẲNG OXY
    # --------------------------------------------------------------------------
    def create_plot_oxy_tab(self):
        tab = ttk.Frame(self.notebook, padding=8)
        self.notebook.add(tab, text="6. Khảo Sát Hàm Số & Đồ Thị Oxy")

        # Equation Ribbon
        self.create_equation_ribbon(tab, lambda: self.plot_f_entry)

        top_f = tk.Frame(tab, bg="#ffffff")
        top_f.pack(fill=tk.X, pady=(0, 4))

        tk.Label(top_f, text="HÀM SỐ CẦN KHẢO SÁT f(x) (HỆ TRỤC TỌA ĐỘ OXY):",
                 font=("Segoe UI", 9, "bold"), fg="#1e293b", bg="#ffffff").pack(anchor="w")
        self.plot_f_entry = ttk.Entry(top_f, font=("Consolas", 11))
        self.plot_f_entry.pack(fill=tk.X, pady=(2, 4))
        self.plot_f_entry.insert(0, "x^3 - 3*x^2 + 2")

        act_f = tk.Frame(top_f, bg="#ffffff")
        act_f.pack(fill=tk.X, pady=(2, 4))

        self.btn_run_plot = tk.Button(
            act_f, text="Khảo sát & Vẽ đồ thị",
            font=("Segoe UI", 8, "bold"), bg="#0969da", fg="#ffffff",
            relief="flat", padx=10, pady=3, cursor="hand2",
            command=self.solve_plot_oxy_action
        )
        self.btn_run_plot.pack(side=tk.LEFT, padx=(0, 10))

        tk.Button(act_f, text="Mẫu Bậc 3: x³ - 3x² + 2", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_plot_sample("x^3 - 3*x^2 + 2")).pack(side=tk.LEFT, padx=3)
        tk.Button(act_f, text="Mẫu Trùng Phương: x⁴ - 2x² - 1", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_plot_sample("x^4 - 2*x^2 - 1")).pack(side=tk.LEFT, padx=3)
        tk.Button(act_f, text="Mẫu Phân Thức: (2x+1)/(x-1)", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_plot_sample("(2*x + 1)/(x - 1)")).pack(side=tk.LEFT, padx=3)
        tk.Button(act_f, text="Mẫu Lượng Giác: sin(x) + cos(x)", font=("Segoe UI", 8), bg="#e2e8f0", relief="flat", padx=8, pady=3,
                  command=lambda: self.load_plot_sample("sin(x) + cos(x)")).pack(side=tk.LEFT, padx=3)

        bot_f = tk.Frame(tab, bg="#ffffff")
        bot_f.pack(fill=tk.BOTH, expand=True)

        left_f = tk.Frame(bot_f, bg="#ffffff")
        left_f.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(0, 4))

        self.lbl_plot_res = tk.Label(left_f, text="BẢNG KHẢO SÁT TOÀN DIỆN SỰ BIẾN THIÊN & ĐỒ THỊ:",
                                     font=("Segoe UI", 9, "bold"), fg="#1e293b", bg="#ffffff")
        self.lbl_plot_res.pack(anchor="w")
        self.plot_result_box = scrolledtext.ScrolledText(left_f, font=("Consolas", self.current_font_size), bg="#ffffff", fg="#0f172a", relief="solid", bd=1)
        self.plot_result_box.pack(fill=tk.BOTH, expand=True)

        self.graph_frame_plot = tk.LabelFrame(bot_f, text="ĐỒ THỊ HÀM SỐ 2D TRÊN HỆ TRỤC TỌA ĐỘ OXY",
                                             font=("Segoe UI", 8, "bold"), fg="#0969da", bg="#ffffff")
        self.graph_frame_plot.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True, padx=(4, 0))

        self.plot_fig = Figure(figsize=(4.5, 4), dpi=100, facecolor='#ffffff')
        self.plot_ax = self.plot_fig.add_subplot(111)
        self.plot_canvas = FigureCanvasTkAgg(self.plot_fig, master=self.graph_frame_plot)
        self.plot_canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)

    def load_plot_sample(self, expr_str: str):
        self.plot_f_entry.delete(0, tk.END)
        self.plot_f_entry.insert(0, expr_str)
        self.solve_plot_oxy_action()

    def solve_plot_oxy_action(self):
        try:
            self.plot_result_box.delete("1.0", tk.END)
            f_str = self.plot_f_entry.get().strip()
            if not f_str:
                return
            f_sym = smart_parse(f_str)

            out = []
            out.append("="*85)
            out.append(f"KHẢO SÁT SỰ BIẾN THIÊN VÀ VẼ ĐỒ THỊ HÀM SỐ TRÊN MẶT PHẲNG OXY")
            out.append(f"Hàm số: y = f(x) = {clean_display_expr(f_sym)}")
            out.append("="*85)

            # 1. TẬP XÁC ĐỊNH
            out.append("\n[1. TẬP XÁC ĐỊNH & TÍNH CHẤT ĐỐI XỨNG]")
            denom = sp.denom(f_sym)
            if denom != 1 and denom.has(x):
                bad_pts = sp.solve(denom, x)
                bad_real = [bp for bp in bad_pts if bp.is_real]
                if bad_real:
                    out.append(f"  • Mẫu số triệt tiêu tại: x ∈ {{{', '.join([str(bp) for bp in bad_real])}}}")
                    out.append(f"  • Tập xác định: D = ℝ \\ {{{', '.join([str(bp) for bp in bad_real])}}}")
                else:
                    out.append("  • Mẫu số luôn khác 0 trên ℝ. Tập xác định: D = ℝ.")
            else:
                out.append("  • Tập xác định: D = ℝ.")

            # Kiểm tra chẵn lẻ
            try:
                diff_even = sp.simplify(f_sym.subs(x, -x) - f_sym)
                diff_odd = sp.simplify(f_sym.subs(x, -x) + f_sym)
                if diff_even == 0:
                    out.append("  • Hàm số chẵn: f(-x) = f(x) ==> Đồ thị nhận trục tung Oy làm trục đối xứng.")
                elif diff_odd == 0:
                    out.append("  • Hàm số lẻ: f(-x) = -f(x) ==> Đồ thị nhận gốc tọa độ O làm tâm đối xứng.")
                else:
                    out.append("  • Đồ thị hàm số không có tính chất đối xứng chẵn lẻ đặc biệt.")
            except Exception:
                pass

            # 2. ĐẠO HÀM BẬC 1 & SỰ BIẾN THIÊN
            df = sp.diff(f_sym, x)
            crit_pts = sp.solve(df, x)
            real_crit = []
            for cp in crit_pts:
                try:
                    cp_eval = cp.evalf()
                    if cp.is_real or abs(complex(cp_eval).imag) < 1e-9:
                        real_crit.append(float(sp.re(cp_eval)))
                except Exception:
                    pass
            real_crit = sorted(list(dict.fromkeys(real_crit)))

            out.append(f"\n[2. ĐẠO HÀM BẬC 1 & SỰ BIẾN THIÊN]")
            out.append(f"  • y' = f'(x) = {clean_display_expr(sp.simplify(df))}")
            if real_crit:
                out.append(f"  • Cho y' = 0 <=> x ∈ {{{', '.join([f'{r:.4f}' for r in real_crit])}}}")
                for r in real_crit:
                    try:
                        y_val = float(sp.re(f_sym.subs(x, r).evalf()))
                        # Xác định CĐ / CT bằng đạo hàm bậc 2
                        d2_val = float(sp.re(sp.diff(df, x).subs(x, r).evalf()))
                        loai = "CỰC TIỂU" if d2_val > 0 else ("CỰC ĐẠI" if d2_val < 0 else "Điểm dừng")
                        out.append(f"    ==> Điểm {loai}: ({r:.2f}; {y_val:.2f})")
                    except Exception:
                        pass
            else:
                out.append("  • Phương trình y' = 0 vô nghiệm thực.")

            # 3. ĐẠO HÀM BẬC 2 & ĐIỂM UỐN
            d2f = sp.diff(df, x)
            infl_pts = sp.solve(d2f, x)
            real_infl = []
            for ip in infl_pts:
                try:
                    ip_eval = ip.evalf()
                    if ip.is_real or abs(complex(ip_eval).imag) < 1e-9:
                        real_infl.append(float(sp.re(ip_eval)))
                except Exception:
                    pass
            real_infl = sorted(list(dict.fromkeys(real_infl)))

            out.append(f"\n[3. ĐẠO HÀM BẬC 2, ĐỘ CONG & ĐIỂM UỐN CỦA ĐỒ THỊ]")
            out.append(f"  • y'' = f''(x) = {clean_display_expr(sp.simplify(d2f))}")
            if real_infl:
                out.append(f"  • Cho y'' = 0 <=> x ∈ {{{', '.join([f'{r:.4f}' for r in real_infl])}}}")
                for r in real_infl:
                    try:
                        y_val = float(sp.re(f_sym.subs(x, r).evalf()))
                        out.append(f"    ==> Điểm uốn U: ({r:.2f}; {y_val:.2f})")
                    except Exception:
                        pass
            else:
                out.append("  • Đồ thị không có điểm uốn đổi dấu độ cong trên ℝ.")

            # 4. TIỆM CẬN
            out.append("\n[4. ĐƯỜNG TIỆM CẬN (MẶT PHẲNG OXY)]")
            asymptotes_v = []
            asymptotes_h = []
            denom_roots = sp.solve(denom, x) if denom != 1 and denom.has(x) else []
            for dr in denom_roots:
                if dr.is_real:
                    asymptotes_v.append(float(dr.evalf()))
                    out.append(f"  • Tiệm cận đứng (TCĐ): x = {float(dr.evalf()):.2f}")

            try:
                lim_pos = sp.limit(f_sym, x, sp.oo)
                lim_neg = sp.limit(f_sym, x, -sp.oo)
                if lim_pos.is_real and not lim_pos.has(sp.oo):
                    asymptotes_h.append(float(lim_pos.evalf()))
                    out.append(f"  • Tiệm cận ngang (TCN): y = {float(lim_pos.evalf()):.2f} (khi x -> +∞)")
                if lim_neg.is_real and not lim_neg.has(sp.oo) and lim_neg != lim_pos:
                    asymptotes_h.append(float(lim_neg.evalf()))
                    out.append(f"  • Tiệm cận ngang (TCN): y = {float(lim_neg.evalf()):.2f} (khi x -> -∞)")
            except Exception:
                pass

            if not asymptotes_v and not asymptotes_h:
                out.append("  • Đồ thị hàm số không có tiệm cận đứng hoặc ngang.")

            # 5. GIAO ĐIỂM VỚI CÁC TRỤC TỌA ĐỘ
            out.append("\n[5. GIAO ĐIỂM VỚI CÁC TRỤC TỌA ĐỘ OX, OY]")
            try:
                y0 = float(sp.re(f_sym.subs(x, 0).evalf()))
                out.append(f"  • Giao với trục tung Oy (x = 0): M(0; {y0:.2f})")
            except Exception:
                out.append("  • Hàm số không xác định tại x = 0 (không cắt trục Oy).")

            try:
                x_intercepts = sp.solve(f_sym, x)
                real_x_int = [float(sp.re(xi.evalf())) for xi in x_intercepts if xi.is_real]
                if real_x_int:
                    out.append(f"  • Giao với trục hoành Ox (y = 0): x ∈ {{{', '.join([f'{xi:.2f}' for xi in real_x_int])}}}")
            except Exception:
                pass

            # 6. DIỆN TÍCH TÍCH PHÂN
            out.append("\n[6. TÍCH PHÂN DIỆN TÍCH HÌNH PHẲNG]")
            try:
                int_val = sp.integrate(sp.Abs(f_sym), (x, 0, 2))
                out.append(f"  • Diện tích S giới hạn bởi đồ thị và Ox trên [0, 2]: S = ∫|f(x)|dx ≈ {float(int_val.evalf()):.4f}")
            except Exception:
                pass

            self.plot_result_box.insert(tk.END, "\n".join(out))

            # VẼ ĐỒ THỊ 2D OXY CHUẨN
            self.plot_fig.clear()
            self.plot_ax = self.plot_fig.add_subplot(111)

            fn = sp.lambdify(x, f_sym, modules=['numpy', {'sqrt': np.lib.scimath.sqrt}])
            xs = np.linspace(-6, 6, 800)
            ys = np.real(fn(xs))
            ys = np.clip(ys, -25, 25)

            # Vẽ đường cong hàm số
            self.plot_ax.plot(xs, ys, color='#0969da', lw=2, label='y = f(x)')

            # Trục tọa độ Ox, Oy
            self.plot_ax.axhline(0, color='#334155', lw=1.2, ls='-')
            self.plot_ax.axvline(0, color='#334155', lw=1.2, ls='-')
            self.plot_ax.text(5.6, 0.5, "Ox", fontsize=9, fontweight='bold', color='#334155')
            self.plot_ax.text(0.3, 13.5, "Oy", fontsize=9, fontweight='bold', color='#334155')
            self.plot_ax.text(0.2, -1.2, "O", fontsize=9, fontweight='bold', color='#334155')

            # Vẽ tiệm cận đứng
            for tc_x in asymptotes_v:
                self.plot_ax.axvline(tc_x, color='#9333ea', lw=1.2, ls='--', label=f'TCĐ: x={tc_x:.1f}')
            # Vẽ tiệm cận ngang
            for tc_y in asymptotes_h:
                self.plot_ax.axhline(tc_y, color='#0284c7', lw=1.2, ls='--', label=f'TCN: y={tc_y:.1f}')

            # Đánh dấu các điểm cực trị
            for cp in real_crit:
                try:
                    cy = float(sp.re(f_sym.subs(x, cp).evalf()))
                    if -6 <= cp <= 6 and -25 <= cy <= 25:
                        self.plot_ax.plot(cp, cy, marker='o', markersize=7, color='#dc2626')
                        self.plot_ax.annotate(f"Cực trị\n({cp:.1f}, {cy:.1f})", (cp, cy),
                                              textcoords="offset points", xytext=(0, 10),
                                              ha='center', fontsize=8, fontweight='bold', color='#dc2626')
                except Exception:
                    pass

            # Đánh dấu điểm uốn
            for ip in real_infl:
                try:
                    iy = float(sp.re(f_sym.subs(x, ip).evalf()))
                    if -6 <= ip <= 6 and -25 <= iy <= 25 and not any(abs(ip - cp) < 1e-2 for cp in real_crit):
                        self.plot_ax.plot(ip, iy, marker='s', markersize=6, color='#ea580c')
                        self.plot_ax.annotate(f"Uốn\n({ip:.1f}, {iy:.1f})", (ip, iy),
                                              textcoords="offset points", xytext=(0, 10),
                                              ha='center', fontsize=8, fontweight='bold', color='#ea580c')
                except Exception:
                    pass

            self.plot_ax.set_title("Đồ Thị Hàm Số & Khảo Sát Biến Thiên Trên Mặt Phẳng Oxy", fontsize=9, fontweight='bold', color='#1e293b')
            self.plot_ax.grid(True, ls=':', color='#cbd5e1')
            self.plot_ax.set_xlim(-6, 6)
            self.plot_ax.set_ylim(-15, 15)
            self.plot_ax.legend(loc='upper right', fontsize=8)
            self.plot_canvas.draw()

        except Exception as e:
            self.plot_result_box.insert(tk.END, f"[LỖI KHẢO SÁT OXY]: {e}")


# ==============================================================================
# MAIN ENTRY POINT
# ==============================================================================

    def apply_theme(self, theme_key: str = "win11_light"):
        """Áp dụng bộ giao diện người dùng theo phong cách Windows 11 / Khung Xanh / Cổ Điển / Tối."""
        if theme_key not in THEMES:
            theme_key = "win11_light"
        self.current_theme_key = theme_key
        t = THEMES[theme_key]

        try:
            self.root.configure(bg=t["bg_window"])
            if hasattr(self, "status_bar") and self.status_bar:
                self.status_bar.configure(bg=t["status_bg"])
            if hasattr(self, "status_lbl") and self.status_lbl:
                self.status_lbl.configure(bg=t["status_bg"], fg=t["status_fg"])
            if hasattr(self, "ai_toolbar") and self.ai_toolbar:
                self.ai_toolbar.configure(bg=t["toolbar_bg"])

            # ttk Style cho Notebook và Tabs
            style = ttk.Style()
            style.theme_use('clam')
            style.configure(".", background=t["bg_window"], foreground=t["text_box_fg"], font=("Segoe UI", 9))
            style.configure("TNotebook", background=t["bg_window"], borderwidth=0)
            style.configure("TNotebook.Tab", background=t["tab_bg"], foreground=t["tab_fg"],
                            font=("Segoe UI", 9, "bold"), padding=[10, 4])
            style.map("TNotebook.Tab",
                      background=[("selected", t["tab_active_bg"])],
                      foreground=[("selected", t["tab_active_fg"])])
            style.configure("TFrame", background=t["bg_card"])
            style.configure("TLabel", background=t["bg_card"], foreground=t["text_box_fg"])

            # Cập nhật đệ quy các widget trong toàn bộ giao diện
            def _apply_widget_theme(w):
                w_class = w.winfo_class()
                try:
                    if w_class in ("Frame",):
                        w_name = str(w).lower()
                        if "canvas" not in w_name:
                            w.configure(bg=t["bg_card"])
                    elif w_class in ("Labelframe", "LabelFrame"):
                        w.configure(bg=t["bg_card"], fg=t["btn_accent_bg"])
                    elif w_class in ("Label",):
                        w.configure(bg=t["bg_card"], fg=t["text_box_fg"])
                    elif w_class in ("Text",):
                        w.configure(bg=t["text_box_bg"], fg=t["text_box_fg"], insertbackground=t["tab_active_fg"])
                    elif w_class in ("Entry",):
                        w.configure(bg=t["entry_bg"], fg=t["entry_fg"], insertbackground=t["tab_active_fg"])
                except Exception:
                    pass
                for ch in w.winfo_children():
                    _apply_widget_theme(ch)

            if hasattr(self, "notebook"):
                for tab_id in self.notebook.tabs():
                    tab_w = self.notebook.nametowidget(tab_id)
                    _apply_widget_theme(tab_w)

            # Cập nhật hộp kết quả văn bản
            for box in [
                getattr(self, 'eq_result_box', None),
                getattr(self, 'ext_result_box', None),
                getattr(self, 'calc_result_box', None),
                getattr(self, 'mat_result_box', None),
                getattr(self, 'stat_result_box', None),
                getattr(self, 'plot_result_box', None)
            ]:
                if box:
                    try:
                        box.configure(bg=t["text_box_bg"], fg=t["text_box_fg"], insertbackground=t["tab_active_fg"])
                    except Exception:
                        pass

            # Cập nhật các đồ thị Matplotlib
            for fig_name in ("eq_fig", "ext_fig", "calc_fig", "plot_fig", "stat_fig"):
                fig = getattr(self, fig_name, None)
                if fig:
                    try:
                        fig.patch.set_facecolor(t["bg_card"])
                        for ax in fig.axes:
                            ax.set_facecolor(t["bg_card"])
                            ax.tick_params(colors=t["text_box_fg"])
                            for spine in ax.spines.values():
                                spine.set_color(t["border_color"])
                            ax.title.set_color(t["text_box_fg"])
                            ax.xaxis.label.set_color(t["text_box_fg"])
                            ax.yaxis.label.set_color(t["text_box_fg"])
                    except Exception:
                        pass

            # Vẽ lại canvas đồ thị
            for c_name in ("eq_canvas", "ext_canvas", "calc_canvas", "plot_canvas", "stat_canvas"):
                c = getattr(self, c_name, None)
                if c:
                    try:
                        c.draw_idle()
                    except Exception:
                        pass

            if hasattr(self, "status_lbl") and self.status_lbl:
                self.status_lbl.config(text=f"Đã chuyển giao diện: {t['name']}")
        except Exception:
            pass


# ==============================================================================
# MAIN ENTRY POINT
# ==============================================================================
def main():
    root = tk.Tk()
    root.withdraw()
    splash = None
    try:
        from stem_shared_core.splash_screen import attach_splash_screen
        splash = attach_splash_screen(
            root,
            app_id="cad_math",
            app_title="CAD Math Studio v2.1",
            min_duration=2.2
        )
    except Exception:
        root.deiconify()

    app = CADMathDesktopAppV2(root)
    if splash:
        splash.set_app_ready()
    root.mainloop()


if __name__ == '__main__':
    main()
